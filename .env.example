# Production (Vercel project price-ranger, www.priceranger.app)
# Create a new Supabase project. The May 2025 project is paused and is not reused.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin used in the magic-link redirect. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.priceranger.app

# Local development can omit the Supabase variables.
# The app then keeps data in data/local-db.json and shows the sign-in link on screen.
# Optional override for the local session cookie secret:
# LOCAL_AUTH_SECRET=

# Feedback mode is limited to this email. Unset locally, the signed-in user is the owner.
# OWNER_EMAIL=

# Optional. Opens a labeled issue on jarpless/price_ranger when feedback is saved.
# Bugs that are not duplicates are also labeled agent-fix. Nothing deploys from that label.
# GITHUB_FEEDBACK_TOKEN=

# Optional. Quote-share mail from support@priceranger.app. Feedback does not email the reporter.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# SUPPORT_FROM_EMAIL=Price Ranger <support@priceranger.app>

# Free trial and free saved prices. Experiment group B adds the extras.
# TRIAL_DAYS=14
# FREE_QUOTE_LIMIT=3
# EXPERIMENT_TRIAL_EXTRA_DAYS=7
# EXPERIMENT_EXTRA_FREE_QUOTES=2

# Stripe. Test mode is the default. Leave this as an sk_test_ key until you choose live mode.
# An sk_live_ key is used only when you set it here (in the host's env, never in git).
# See docs/STRIPE_LIVE_CHECKLIST.md. Do not commit real keys.
# STRIPE_SECRET_KEY=sk_test_
# STRIPE_WEBHOOK_SECRET=
# Price ids from the Stripe dashboard. Required before live checkout. Optional in test mode,
# where checkout falls back to the amounts in lib/plans.ts.
# STRIPE_PRICE_PASS=
# STRIPE_PRICE_PLUS_MONTH=
# STRIPE_PRICE_PLUS_YEAR=
# STRIPE_PRICE_PRO_MONTH=
# Set to true only after Stripe Tax is configured in the dashboard. Default is off.
# STRIPE_AUTOMATIC_TAX=
# Optional. Lets checkout update the plan, and lets the funnel admin read every account.
# SUPABASE_SERVICE_ROLE_KEY=

# Assistant. Set one. OpenAI is used when both are set. Neither is required to run the app.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Cheap ask model, stronger agent model. OPENAI_MODEL / ANTHROPIC_MODEL still work as the ask default.
# OPENAI_ASK_MODEL=gpt-4o-mini
# OPENAI_AGENT_MODEL=gpt-4o
# ANTHROPIC_ASK_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_AGENT_MODEL=claude-3-5-sonnet-latest
# ASSISTANT_SEAL_SECRET=

# Show a provider button only after that provider is enabled in Supabase.
# NEXT_PUBLIC_AUTH_GOOGLE=true
# NEXT_PUBLIC_AUTH_FACEBOOK=true
# NEXT_PUBLIC_AUTH_AZURE=true
# Leave Apple off until the iOS app (v2.4 Outpost).
# NEXT_PUBLIC_ENABLE_APPLE=false

# Vercel sets these. Do not commit real values.
# VERCEL_GIT_COMMIT_SHA=
# VERCEL_ENV=
