# Production (Vercel project price-ranger, www.priceranger.app)
# Create a new Supabase project. The May 2025 project is paused and is not reused.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin used in the magic-link redirect. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.priceranger.app

# Local development can omit the Supabase variables.
# The app then keeps data in data/local-db.json and shows the sign-in link on screen.
# Optional override for the local session cookie secret:
# LOCAL_AUTH_SECRET=
